# ==============================================================================
# SmartSOP AI — Configuration Environment Variables
# ==============================================================================

PROJECT_NAME="SmartSOP AI Factory Assistant"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
# Default: SQLite (nhẹ, sẵn sàng chạy ngay không cần cài PostgreSQL server)
# Production / PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/smartsop_db
DATABASE_URL="sqlite+aiosqlite:///./data/smartsop.db"

# JWT Security
SECRET_KEY="smartsop-dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Origins (JSON list or comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Storage Paths
UPLOAD_DIR="./data/uploads"
CHROMA_PERSIST_DIR="./data/chromadb"

# AI & LLM Settings
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"
EMBEDDING_MODEL_NAME="BAAI/bge-m3"
SIMILARITY_THRESHOLD=0.65

